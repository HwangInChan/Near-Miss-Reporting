# ============================================================
# DB 연결 설정
#
# 아무것도 설정하지 않으면 로컬 파일(data/near-miss.db)을 사용한다.
# 로컬 개발은 이 파일 없이도 그대로 동작한다.
#
# 배포(Turso 원격 DB)를 쓰려면 아래 두 값을 채운다.
#   1) https://turso.tech 가입 후 데이터베이스 생성
#   2) Turso CLI 또는 대시보드에서 URL과 토큰 확인
#        turso db show <DB이름> --url
#        turso db tokens create <DB이름>
#   3) Render의 Environment 탭에 아래 두 변수를 등록
# ============================================================

# TURSO_DATABASE_URL=libsql://your-db-name-yourorg.turso.io
# TURSO_AUTH_TOKEN=eyJhbGciOi...

# 로컬 DB 파일 경로를 직접 지정하고 싶을 때만 사용 (기본값: data/near-miss.db)
# DB_FILE_PATH=/some/path/near-miss.db
